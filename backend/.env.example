APP_NAME=EvidenceGraph Backend
APP_ENV=local
HOST=127.0.0.1
PORT=8010
AUTH_MODE=disabled
API_AUTH_TOKEN=
DATA_DIR=./data

# local: no external services; mineru: call MinerU precise API
PIPELINE_MODE=local
EXTRACTOR_MODE=heuristic
QA_MODE=auto

# Required only for PIPELINE_MODE=mineru
MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=pipeline
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_IS_OCR=false
MINERU_PAGE_RANGE=
MINERU_POLL_INTERVAL_SEC=5
MINERU_POLL_TIMEOUT_SEC=300

# Required only for EXTRACTOR_MODE=langextract or QA_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_THINKING=disabled

MAX_UPLOAD_MB=200
MAX_PAGES=200
LLM_MAX_WORKERS=2
QA_MAX_TOOL_CALLS=6

